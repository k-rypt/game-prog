  m_Name: WinDialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - name: Eira
    text: Hello, Mom?
  - name: Mom
    text: Yes, hon?
  - name: Eira
    text: I won, Mom...
  - name: Eira
    text: 'You don''t have to worry anymore. '
  - name: Eira
    text: Eli's bills are taken care of.
  - name: Mom
    text: What? What happened? I mean, that's good news but what happened?
  - name: Eira
    text: 'I''m going home, I''ll explain when I get there. '
  - name: Mom
    text: That's good to hear, be careful on the way
